# =================================================================
# Valleycentia E-Commerce Platform — Environment Configuration Template
# =================================================================
# Copy this file to .env.local for local development.
# In production (Vercel / Cloud), set these variables in the dashboard.

# -----------------------------------------------------------------
# 1. DATABASE (MongoDB Atlas)
# -----------------------------------------------------------------
# Required: Standard or SRV connection string with replica set support
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"

# -----------------------------------------------------------------
# 2. AUTHENTICATION (Clerk)
# -----------------------------------------------------------------
# Required: Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Clerk URL paths (must match app routing)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/auth/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/auth/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# -----------------------------------------------------------------
# 3. SITE URL & HOSTING
# -----------------------------------------------------------------
# Base URL for canonical links, sitemaps, and absolute URLs
NEXT_PUBLIC_BASE_URL="https://valleycentia.com"

# -----------------------------------------------------------------
# 4. ADMIN & OMS ACCESS CONTROL (RBAC)
# -----------------------------------------------------------------
# Comma-separated list of admin email addresses and Clerk user IDs
ADMIN_EMAILS="admin@valleycentia.com,operations@valleycentia.com"
ADMIN_USER_IDS="user_..."

# -----------------------------------------------------------------
# 5. PAYMENT GATEWAY (SSLCommerz)
# -----------------------------------------------------------------
# Optional for local test; Required for live online payments
SSLCOMMERZ_STORE_ID="valleycentia_store"
SSLCOMMERZ_STORE_PASSWORD="store_password"
SSLCOMMERZ_IS_SANDBOX="true"

# -----------------------------------------------------------------
# 6. TRANSACTIONAL NOTIFICATIONS (Resend / Email)
# -----------------------------------------------------------------
# Optional: Set RESEND_API_KEY to send live customer order confirmation emails
RESEND_API_KEY=""
NOTIFICATION_FROM_EMAIL="Valleycentia <orders@valleycentia.com>"

# -----------------------------------------------------------------
# 7. AI SEARCH ENGINE (Google Gemini)
# -----------------------------------------------------------------
# Optional: Used for natural language semantic product query resolution
GEMINI_API_KEY=""
