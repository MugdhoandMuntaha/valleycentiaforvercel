# =================================================================
# Valleycentia Admin Panel — Environment Configuration Template
# =================================================================

# MongoDB Database Connection
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"

# NextAuth Settings
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="your-nextauth-secret-key-at-least-32-chars"

# Storefront URL & Cross-App Revalidation
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
STOREFRONT_URL="http://localhost:3000"
REVALIDATE_SECRET="your-revalidate-secret-token"

# Admin Access Control
ADMIN_EMAILS="admin@valleycentia.com"
ADMIN_USER_IDS=""
